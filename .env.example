# Copy this file to .env and fill it in.
# Every variable marked as secret also accepts NAME_FILE, the path of a file holding the value
# (handy with Docker secrets). Set one or the other, never both.

# SEI address, without /sei at the end. E.g. https://sei.rr.gov.br
SEI_URL=
# Address of the mod-wssei API. Only set it if automatic discovery fails.
SEI_API_URL=
SEI_USERNAME=
# Secret. Prefer SEI_PASSWORD_FILE or SEI_PASSWORD_CMD: environment variables can be read by
# anyone who can inspect the process or the container. Set exactly one of the three.
SEI_PASSWORD=
# SEI_PASSWORD_FILE=/run/secrets/sei_password
# Command that prints the password, run at every login, without a shell. E.g. pass show sei/monitor
# SEI_PASSWORD_CMD=
# Agency acronym (e.g. SECONV) or numeric id. The orgs command lists them.
SEI_ORG=
# Unit acronyms, separated by commas, or "all". Empty watches your current unit.
SEI_UNITS=
# Time zone of the dates shown by SEI. Roraima uses America/Boa_Vista.
SEI_TIMEZONE=America/Sao_Paulo
# Time between checks. Minimum: 5m.
POLL_INTERVAL=15m
# Simultaneous calls to the SEI API, from 1 to 10.
SEI_CONCURRENCY=3

# Database. Default: SQLite in the /data volume. Secret, since it may hold a password.
DATABASE_URL=sqlite:///data/sei-monitor.db
# With the compose postgres profile, swap the line above for this one and set POSTGRES_PASSWORD:
# DATABASE_URL=postgres://sei_monitor:change-this-password@postgres:5432/sei_monitor?sslmode=disable
# POSTGRES_PASSWORD=change-this-password

# HTTP server for /healthz, the RSS feed and the API. Leave it empty to turn the server off.
# Behind an nginx on the same host, use 127.0.0.1:8080.
HTTP_ADDRESS=:8080
# Optional. Public address where nginx serves sei-monitor, with the prefix (e.g. https://example.org/api/v1).
# When set, the feed links to itself (atom:link rel="self"), which puts the feed address, token
# included, inside the feed. Leave it empty to keep the token out of the feed body.
PUBLIC_URL=
# Secret, at least 32 characters. Turns on the RSS feed at /feed/<FEED_TOKEN>.xml.
# Create one with the generate-token command. With the HTTP server on, set FEED_TOKEN, API_TOKEN or both.
FEED_TOKEN=
# Secret, at least 32 characters, different from FEED_TOKEN. Turns on the JSON API.
API_TOKEN=

# minimal: event type, process number, unit and date.
# full: adds the process type and description, the activity text and the document name.
NOTIFICATION_DETAIL=minimal
# How much the API shows of each process and event: minimal or full. Default: NOTIFICATION_DETAIL.
API_DETAIL=
# How many days before a scheduled return to send a reminder.
RETURN_WARNING_DAYS=2
# debug, info, warn or error.
LOG_LEVEL=info

# Email. The channel turns on when SMTP_HOST is set.
SMTP_HOST=
# Default: 587 with starttls, 465 with tls, 25 with none.
SMTP_PORT=
SMTP_USERNAME=
# Secret.
SMTP_PASSWORD=
SMTP_FROM=
# One or more addresses, separated by commas.
SMTP_TO=
# starttls, tls or none.
SMTP_TLS=starttls

# Telegram. The channel turns on when TELEGRAM_TOKEN is set.
# Secret.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy. The channel turns on when NTFY_URL is set. E.g. https://ntfy.sh/my-topic
NTFY_URL=
# Secret, optional.
NTFY_TOKEN=

# Webhook. The channel turns on when WEBHOOK_URL is set.
WEBHOOK_URL=
# Secret used to sign the body with HMAC-SHA256.
WEBHOOK_SECRET=

# WhatsApp. The channel turns on when WHATSAPP_RECIPIENTS is set.
# Phone numbers with country and area code (e.g. 5595991234567) or group ids (ending in @g.us),
# separated by commas.
WHATSAPP_RECIPIENTS=
