POSTGRES_PASSWORD=change-me

# Compose reads this file. The monitor and the tests don't, so export what you need in your shell.

# Exported in your shell, with the same password as POSTGRES_PASSWORD, this makes cargo test use the
# compose Postgres instead of starting its own.
TEST_DATABASE_URL=postgres://sei_monitor:change-me@127.0.0.1:5432/sei_monitor?sslmode=disable

# The monitor's settings, with their defaults. Under monitor-hub, set them on the hub with the SEI__
# prefix (SEI__SEI_URL and so on). The hub removes the prefix before it starts the monitor.

# Required, secret. The monitor connects without TLS. DATABASE_URL_FILE reads it from a file.
DATABASE_URL=postgres://sei_monitor:change-me@127.0.0.1:5432/sei_monitor?sslmode=disable
# Required. The SEI address without /sei at the end. Use https; plain http works only for localhost.
SEI_URL=https://sei.example.invalid
# Address of the mod-wssei API. Set it only if discovery fails.
SEI_API_URL=
# Required.
SEI_USERNAME=
# Required, secret. Set exactly one of SEI_PASSWORD, SEI_PASSWORD_FILE and SEI_PASSWORD_CMD.
SEI_PASSWORD=
# SEI_PASSWORD_FILE=/run/secrets/sei_password
# A command that prints the password. It runs at every login, without a shell, with a 30 s limit.
# SEI_PASSWORD_CMD=pass show sei/monitor
# Required. The agency acronym or numeric id, as the orgs command lists them.
SEI_ORG=
# Unit acronyms separated by commas, or all. Empty means the user's current unit.
SEI_UNITS=
# The time zone of the dates SEI shows. Roraima uses America/Boa_Vista.
SEI_TIMEZONE=America/Sao_Paulo
# Simultaneous calls to SEI, 1 to 10.
SEI_CONCURRENCY=3
# Time between checks, at least 5m.
POLL_INTERVAL=15m
# Days before a scheduled return to report it, 0 to 60.
RETURN_WARNING_DAYS=2
# Days to keep events and the processes that left your units, 0 to 3650. Use at least
# RETURN_WARNING_DAYS + 2, or 0 to keep everything. Events the hub has not read are never deleted.
RETENTION_DAYS=90
# minimal or full. full adds the process type and description, the activity text and the document
# name to each event.
NOTIFICATION_DETAIL=minimal
# debug, info, warn or error.
LOG_LEVEL=info
