# Copie para .env e preencha.
# Toda variável marcada como segredo também aceita NOME_FILE, com o caminho de um arquivo
# (útil com Docker secrets). Defina uma ou outra, nunca as duas.

# Endereço do SEI do órgão, sem /sei no fim. Ex.: https://sei.rr.gov.br
SEI_URL=
# Endereço da API do mod-wssei. Só preencha se a detecção automática falhar.
SEI_API_URL=
SEI_USUARIO=
# Segredo.
SEI_SENHA=
# Sigla (ex.: SECONV) ou id numérico do órgão. O subcomando `orgaos` lista os disponíveis.
SEI_ORGAO=
# Siglas das unidades, separadas por vírgula, ou "todas". Vazio monitora a unidade atual.
SEI_UNIDADES=
# Fuso das datas do SEI. Em Roraima: America/Boa_Vista.
SEI_FUSO=America/Sao_Paulo
# Intervalo entre consultas ao SEI. Mínimo: 5m.
INTERVALO=15m
# Chamadas simultâneas à API do SEI.
SEI_CONCORRENCIA=3

# Banco. Padrão: SQLite no volume /data.
DATABASE_URL=sqlite:///data/sei-monitor.db
# Com o perfil postgres do compose, troque a linha acima por esta e defina POSTGRES_SENHA:
# DATABASE_URL=postgres://sei_monitor:troque-esta-senha@postgres:5432/sei_monitor?sslmode=disable
# POSTGRES_SENHA=troque-esta-senha

# Servidor HTTP do feed RSS e do /healthz. Deixe vazio para desligar.
HTTP_ENDERECO=:8080
# Segredo, com pelo menos 32 caracteres. Gere um com o subcomando `gerar-token`.
FEED_TOKEN=

# minimo: tipo do evento, número do processo, unidade e data.
# completo: acrescenta tipo e descrição do processo, texto do andamento e nome do documento.
NOTIFICACAO_DETALHE=minimo
# Com quantos dias de antecedência avisar do retorno programado.
RETORNO_AVISO_DIAS=2
# debug, info, warn ou error.
LOG_NIVEL=info

# E-mail. O canal liga quando SMTP_HOST está preenchido.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
# Segredo.
SMTP_SENHA=
SMTP_DE=
# Um ou mais endereços, separados por vírgula.
SMTP_PARA=
# starttls, tls ou nenhum.
SMTP_TLS=starttls

# Telegram. O canal liga quando TELEGRAM_TOKEN está preenchido.
# Segredo.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy. O canal liga quando NTFY_URL está preenchido. Ex.: https://ntfy.sh/meu-topico
NTFY_URL=
# Segredo, opcional.
NTFY_TOKEN=

# Webhook. O canal liga quando WEBHOOK_URL está preenchido.
WEBHOOK_URL=
# Segredo usado na assinatura HMAC do corpo.
WEBHOOK_SEGREDO=

# WhatsApp. O canal liga quando WHATSAPP_DESTINOS está preenchido.
# Números com DDI e DDD (ex.: 5595991234567) ou ids de grupo (terminam em @g.us), separados por vírgula.
WHATSAPP_DESTINOS=
