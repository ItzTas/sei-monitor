#!/bin/sh
set -e

toolchain=$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)

run_cargo() {
	if command -v rustup >/dev/null 2>&1; then
		rustup run "$toolchain" cargo "$@"
		return
	fi
	cargo "$@"
}

if ! run_cargo fmt --check; then
	echo "pre-commit: run cargo fmt" >&2
	exit 1
fi

echo "pre-commit: cargo test"
run_cargo test
